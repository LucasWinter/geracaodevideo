# Copie para .env e preencha. Rode `gdv doctor` depois para conferir.

# --------------------------------------------------------------- catalogo
# csv      = data/*.csv locais (nao aparece no site)
# supabase = fonte de verdade unica, compartilhada com o painel web
GDV_BACKEND=supabase

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=

# A RLS exige sessao autenticada: sem login o banco nao devolve nada.
# Nao existe service-role key neste projeto, de proposito.
SUPABASE_EMAIL=
SUPABASE_SENHA=

# ------------------------------------------------------------------- llm
# Opcional. Sem a chave, o redator cai para o modo template (deterministico,
# offline) e o briefing continua funcionando.
GEMINI_API_KEY=

# --------------------------------------------------------------- montagem
# Fonte usada no overlay do gancho (camada 5). Sem uma fonte valida o video
# sai SEM o texto na tela. Descomente a linha do seu sistema.
# Windows:
# GDV_FONTE=C:\Windows\Fonts\arialbd.ttf
# macOS:
# GDV_FONTE=/System/Library/Fonts/Supplemental/Arial Bold.ttf
# Linux:
# GDV_FONTE=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
